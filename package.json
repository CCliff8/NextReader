{
  "name": "nextreader",
  "version": "0.1.0",
  "description": "Markdown reader and editor with syntax highlighting",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "license": "MIT",
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0",
    "electron": "^45.2.3"
  },
  "productName": "NextReader",
  "author": "CCliff8",
  "build": {
    "appId": "com.ccliff8.nextreader",
    "productName": "NextReader",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json",
      "node_modules/monaco-editor/min/**",
      "node_modules/marked/lib/marked.umd.js",
      "node_modules/dompurify/dist/purify.min.js",
      "node_modules/@highlightjs/cdn-assets/highlight.min.js",
      "node_modules/@highlightjs/cdn-assets/styles/github*.min.css"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null,
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdx"
          ],
          "name": "Markdown",
          "role": "Editor"
        }
      ]
    },
    "directories": {
      "output": "dist"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CCliff8/NextReader.git"
  }
}
